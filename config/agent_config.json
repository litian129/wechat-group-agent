  "response_templates": {
    "booking_preamble_1": "\u611f\u8c22\u60a8\u9009\u62e9\u6e05\u65b0\u5168\u5bb6\u79d1\u8fc8\u65af\u8bfa\u8fdb\u884c\u6cbb\u7406\n\u8fd9\u4e2a\u662f\u54b1\u4eec\u540e\u7eed\u7684\u4e13\u5c5e\u670d\u52a1\u7fa4\uff0c\u6b64\u7fa4\u4e0d\u4f1a\u89e3\u6563\uff0c\u60a8\u540e\u7eed\u6709\u4efb\u4f55\u95ee\u9898\u90fd\u53ef\u4ee5\u7fa4\u5185\u8fdb\u884c\u6c9f\u901a\n\u7fa4\u5185\u6709\u54b1\u4eec\u5404\u4e2a\u90e8\u95e8\u7684\u8d1f\u8d23\u4eba\u5458",
